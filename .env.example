# =====================================================================
# .env.example — Variables d'environnement et mots de passe de DÉMO
# Copier ce fichier vers .env et adapter si nécessaire.
# ⚠️  TOUS les mots de passe ci-dessous sont des VALEURS DE DÉMO,
#     réservées à un environnement de démonstration hors production.
#     Les vrais secrets sont générés par scripts/init.sh (secrets/).
# =====================================================================

# Adresse IP du serveur sur le réseau local (sans https://)
KIBARE_SERVER_ADDRESS=192.168.10.10

# ---------------------------------------------------------------------
# Mots de passe de DÉMO (comptes fictifs, voir docs/COMPTES_DEMO.md)
# ---------------------------------------------------------------------
# Les mots de passe réels des services sont générés aléatoirement par
# scripts/init.sh et stockés dans secrets/ (jamais versionnés).

# Comptes agents de démo (matricule : mot de passe) — 12 caractères min.
#   demo-000 : DemoPass000!
#   demo-101 : DemoPass101!
#   demo-102 : DemoPass102!
#   demo-201 : DemoPass201!
#   demo-202 : DemoPass202!
#   demo-203 : DemoPass203!
#   demo-301 : DemoPass301!
#   demo-302 : DemoPass302!
#   demo-401 : DemoPass401!
#   demo-402 : DemoPass402!
