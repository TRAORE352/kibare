# log.config - Configuration de logging pour Synapse
# Format structuré JSON, pas de contenu de message dans les logs

version: 1

formatters:
  json:
    class: logging.Formatter
    format: '{"timestamp": "%(asctime)s", "level": "%(levelname)s", "logger": "%(name)s", "message": "%(message)s"}'

handlers:
  console:
    class: logging.StreamHandler
    formatter: json
    stream: ext://sys.stdout

loggers:
  synapse:
    level: INFO
    handlers: [console]
    propagate: false
  synapse.storage:
    level: WARNING
    handlers: [console]
    propagate: false
  synapse.handlers:
    level: INFO
    handlers: [console]
    propagate: false

root:
  level: INFO
  handlers: [console]

# Important : ne PAS logger le contenu des messages
# Les événements Matrix sont loggés sans leur contenu (type seulement)
# Exemple : "Received event type=m.room.encrypted" sans le corps chiffré