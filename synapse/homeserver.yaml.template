# homeserver.yaml.template — Configuration Synapse pour Kibaré
# =====================================================================
# Ce fichier est un MODÈLE. scripts/init.sh le copie vers homeserver.yaml
# en remplaçant les marqueurs __...__ par les vraies valeurs (secrets de
# démo + adresse du serveur). Le fichier généré est ignoré par Git.
#
# Version Synapse figée : 1.164.1 (image matrixdotorg/synapse:v1.164.1)
# Référence officielle : https://element-hq.github.io/synapse/latest/usage/configuration/config_documentation.html
# =====================================================================

# Nom du serveur Matrix. Identifiant STABLE (utilisé dans les adresses
# @utilisateur:kibare.test), indépendant de l'adresse IP du serveur.
server_name: "kibare.test"

pid_file: /data/homeserver.pid

# Écouteur HTTP interne uniquement. Caddy gère le TLS en amont.
# Aucun port 8448 ni ressource "federation" : la fédération est interdite.
listeners:
  - port: 8008
    bind_addresses: ['0.0.0.0']
    type: http
    tls: false
    x_forwarded: true
    resources:
      - names: [client]   # uniquement l'API client, pas "federation"
        compress: true

# Adresse publique du serveur (utilisée pour le callback OIDC et les URL client)
public_baseurl: "https://__KIBARE_ADDRESS__"

# Base de données PostgreSQL
database:
  name: psycopg2
  args:
    user: postgres
    password: __POSTGRES_PASSWORD__
    dbname: synapse
    host: postgres
    port: 5432
    cp_min: 5
    cp_max: 20

# Répertoire des médias. Les fichiers y sont stockés CHIFFRÉS côté client
# (pièces jointes Matrix chiffrées) : le serveur ne voit que des octets opaques.
media_store_path: /data/media_store

log_config: "/data/log.config"
signing_key_path: "/data/kibare.signing.key"

# =====================================================================
# RÈGLES ÉLIMINATOIRES (section 2 du brief)
# =====================================================================

# Inscription désactivée : personne ne crée son propre compte.
# Seul un administrateur enrôle un agent via la Console.
enable_registration: false

# Secret partagé utilisé UNIQUEMENT par l'outil register_new_matrix_user pour
# créer le compte technique @kibare-bot (gestion des salons). Il ne permet PAS
# l'inscription libre (enable_registration reste à false).
registration_shared_secret: __REGISTRATION_SHARED_SECRET__

# Pas de mot de passe Synapse : connexion UNIQUEMENT via Keycloak (OIDC).
# Sans cette ligne, un mot de passe Synapse permettrait de contourner
# l'enrôlement + l'OTP de Keycloak.
password_config:
  enabled: false

# Chiffrement de bout en bout imposé pour TOUS les salons, y compris les
# discussions privées. Le serveur ne stocke donc jamais de message en clair.
encryption_enabled_by_default_for_room_type: all

# Aperçus de liens désactivés : le serveur ne doit pas aller lire les URLs.
url_preview_enabled: false

# Fédération désactivée : aucune communication avec l'extérieur.
federation_domain_whitelist: []

# Pas de rapport de statistiques vers matrix.org.
report_stats: false

# Aucun serveur de clés externe (matrix.org). La vérification des clés est
# purement locale, la fédération étant coupée de toute façon.
trusted_key_servers: []

# =====================================================================
# MINIMISATION DES MÉTADONNÉES (section 5.5 du brief)
# =====================================================================

# Pas de statut en ligne/hors ligne.
presence:
  enabled: false

require_auth_for_profile_requests: true
limit_profile_requests_to_users_who_share_rooms: true
include_profile_data_on_invite: false
allow_public_rooms_without_auth: false
allow_public_rooms_over_federation: false

# Adresses IP conservées 1 jour seulement.
user_ips_max_age: 1d

# Les événements masqués (redactions) sont purgés après 1 jour.
redaction_retention_period: 1d

# Rétention : les anciens événements (chiffrés) sont supprimés après 30 jours.
retention:
  enabled: true
  default_policy:
    min_lifetime: 1d
    max_lifetime: 30d
  allowed_lifetime_min: 1d
  allowed_lifetime_max: 365d

# =====================================================================
# OIDC / KEYCLOAK (section 5.3 et 5.7 du brief)
# =====================================================================

oidc_providers:
  - idp_id: keycloak
    idp_name: "Connexion Kibaré"
    # L'issuer doit être IDENTIQUE pour le téléphone et pour Synapse
    # (problème d'« issuer » si l'adresse diffère). On utilise l'adresse
    # du serveur de façon canonique.
    issuer: "https://__KIBARE_ADDRESS__/auth/realms/kibare"
    client_id: "synapse"
    # Le secret du client OIDC est lu depuis un fichier (jamais en clair
    # dans ce fichier de config).
    client_secret_path: /run/secrets/oidc_client_secret
    scopes: ["openid", "profile"]
    # Inscription automatique DÉSACTIVÉE : le compte Matrix doit déjà exister
    # (créé par la Console au moment de l'enrôlement). Un compte Keycloak
    # valide mais non enrôlé ne peut donc pas se connecter.
    enable_registration: false
    # Autorise la connexion d'un compte Matrix pré-créé par la Console.
    allow_existing_users: true
    user_mapping_provider:
      config:
        # L'identifiant Matrix devient @<matricule>:kibare.test
        localpart_template: "{{ user.preferred_username }}"
        display_name_template: "{{ user.name }}"
        email_template: "{{ user.email }}"

# =====================================================================
# NOTIFICATIONS SANS CONTENU (section 5.5 du brief)
# =====================================================================

# Pas de calcul de notifications push côté serveur (l'app F-Droid utilise
# la synchronisation en arrière-plan, sans Firebase).
push:
  enabled: false
  include_content: false

# =====================================================================
# LIMITES ET QUOTAS
# =====================================================================

# Taille maximale d'un fichier envoyé (chiffré côté client).
max_upload_size: 50M

# Limite de débit des messages (protection anti-inondation).
rc_message:
  per_second: 0.5
  burst_count: 10

# =====================================================================
# PAS DE TURN/STUN (pas d'appel audio/vidéo dans le MVP)
# =====================================================================
turn_uris: []
