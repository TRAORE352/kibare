  "clientScopes": [
    {
      "name": "roles",
      "description": "Rôles Keycloak mappés dans le token ID",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false",
        "gui.order": ""
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "openid",
    "profile"
  ],
  "defaultOptionalClientScopes": [
    "roles",
    "email"
  ],
  "identityProviders": [],
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "rsa-generated",
        "providerId": "rsa-generated",
        "providerType": "org.keycloak.keys.KeyProvider",
        "parentId": "kibare",
        "config": {
          "priority": ["100"],
          "enabled": ["true"],
          "active": ["true"],
          "keySize": ["2048"],
          "algorithm": ["RS256"]
        }
      }
    ],
    "org.keycloak.authentication.authenticators.browser.UsernamePasswordFormFactory": [
      {
        "name": "UsernamePasswordForm",
        "providerId": "authenticator",
        "providerType": "org.keycloak.authentication.authenticators.browser.UsernamePasswordFormFactory",
        "parentId": "browser",
        "config": {}
      }
    ],
    "org.keycloak.authentication.authenticators.browser.TOTPAuthenticatorFactory": [
      {
        "name": "TOTP",
        "providerId": "authenticator",
        "providerType": "org.keycloak.authentication.authenticators.browser.TOTPAuthenticatorFactory",
        "parentId": "browser",
        "config": {}
      }
    ],
    "org.keycloak.authentication.requiredactions.TOTPSetupFactory": [
      {
        "name": "CONFIGURE_TOTP",
        "providerId": "required-action",
        "providerType": "org.keycloak.authentication.requiredactions.TOTPSetupFactory",
        "parentId": "kibare",
        "config": {
          "totp.algorithm": ["HmacSHA1"],
          "totp.digits": ["6"],
          "totp.period": ["30"],
          "totp.look.ahead.window": ["1"]
        }
      }
    ]
  },
  "authenticationFlows": [
    {
      "alias": "browser",
      "description": "Flux d'authentification navigateur avec OTP obligatoire",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "UsernamePasswordForm",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "TOTP",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    }
  ],
  "requiredActions": [
    {
      "providerId": "CONFIGURE_TOTP",
      "name": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10,
      "config": {
        "totp.algorithm": ["HmacSHA1"],
        "totp.digits": ["6"],
        "totp.period": ["30"],
        "totp.look.ahead.window": ["1"]
      }
    },
    {
      "providerId": "UPDATE_PASSWORD",
