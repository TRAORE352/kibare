+/*
+ * Kibaré — connexion SSO à l'intérieur de l'application.
+ *
+ * POURQUOI CE FICHIER EXISTE
+ *
+ * Element ouvre l'écran de connexion SSO dans un « onglet personnalisé »
+ * Chrome, c'est-à-dire dans le navigateur du téléphone. Or le navigateur est
+ * une autre application : il ne connaît pas l'autorité de certification de
+ * l'État burkinabè embarquée dans Kibaré. Face au certificat du serveur de
+ * l'administration, il refuse silencieusement la connexion — l'agent voit une
+ * PAGE BLANCHE, sans message d'erreur.
+ *
+ * La connexion se fait donc désormais dans une vue web interne à
+ * l'application. Deux bénéfices au-delà de la correction du défaut :
+ *
+ *   — la page de connexion ne quitte jamais l'application : le mot de passe et
+ *     le code à usage unique de l'agent ne transitent pas par un navigateur
+ *     tiers, qui pourrait les enregistrer ou les synchroniser vers un service
+ *     en ligne ;
+ *   — l'application refuse tout serveur dont le certificat n'est pas délivré
+ *     par l'autorité de l'État, y compris un serveur muni d'un certificat
+ *     acheté dans le commerce.
+ *
+ * COMMENT LE CERTIFICAT EST VALIDÉ
+ *
+ * Une vue web Android n'applique pas la configuration réseau de
+ * l'application : elle ne consulte que les autorités préinstallées par le
+ * fabricant du téléphone. Le certificat de l'État lui est donc inconnu.
+ *
+ * Plutôt que d'inspecter le certificat que la vue web nous présente — ce que
+ * les API Android ne permettent pas de faire de façon fiable sur toutes les
+ * versions — on établit NOTRE PROPRE connexion sécurisée vers le serveur,
+ * avant d'afficher la page, en n'acceptant que l'autorité de l'État. Si cette
+ * connexion aboutit, le serveur est authentique et la page peut être
+ * affichée. Si elle échoue, on refuse avec un message explicite.
+ *
+ * Cette vérification s'appuie sur la validation standard de Java : chaîne de
+ * certificats complète, dates de validité, et correspondance du nom avec
+ * l'adresse visitée. Nous n'écrivons aucune règle de confiance nous-mêmes —
+ * nous remplaçons seulement la liste des autorités acceptées par la nôtre.
+ */
+
+package im.vector.app.features.kibare
+
+import android.content.ActivityNotFoundException
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.net.http.SslError
+import android.os.Bundle
+import android.view.ViewGroup
+import android.view.WindowManager
+import android.webkit.SslErrorHandler
+import android.webkit.WebResourceRequest
+import android.webkit.WebView
+import android.webkit.WebViewClient
+import android.widget.Toast
+import androidx.appcompat.app.AppCompatActivity
+import im.vector.app.R
+import java.io.IOException
+import java.net.URL
+import java.security.KeyStore
+import java.security.cert.CertificateFactory
+import java.security.cert.X509Certificate
+import javax.net.ssl.HttpsURLConnection
+import javax.net.ssl.SSLContext
+import javax.net.ssl.TrustManagerFactory
+
+class KibareSsoWebActivity : AppCompatActivity() {
+
+    private var webView: WebView? = null
+
+    /** Hôte dont l'authenticité a été prouvée avant l'affichage de la page. */
+    private var hoteAuthentifie: String? = null
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+
+        // Protection « Zéro fuite » : ni capture d'écran ni aperçu dans la
+        // liste des applications récentes pendant la saisie du mot de passe
+        // et du code à usage unique.
+        window.setFlags(
+                WindowManager.LayoutParams.FLAG_SECURE,
+                WindowManager.LayoutParams.FLAG_SECURE
+        )
+
+        val url = intent.getStringExtra(EXTRA_SSO_URL)
+        if (url.isNullOrEmpty()) {
+            finish()
+            return
+        }
+
+        val hote = Uri.parse(url).host
+        if (hote.isNullOrEmpty()) {
+            refuser()
+            return
+        }
+
+        // La vérification ouvre une connexion réseau : jamais sur le fil
+        // principal, sinon Android interrompt l'application.
+        Thread {
+            val authentique = serveurPresenteUnCertificatDeLEtat(url)
+            runOnUiThread {
+                if (isFinishing) return@runOnUiThread
+                if (authentique) {
+                    hoteAuthentifie = hote
+                    afficherPage(url)
+                } else {
+                    refuser()
+                }
+            }
+        }.start()
+    }
+
+    private fun afficherPage(url: String) {
+        val vue = WebView(this)
+        vue.layoutParams = ViewGroup.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.MATCH_PARENT
+        )
+
+        // Keycloak a besoin de JavaScript et du stockage local pour afficher
+        // le formulaire de connexion et l'étape du code à usage unique.
+        vue.settings.javaScriptEnabled = true
+        vue.settings.domStorageEnabled = true
+
+        vue.webViewClient = ClientKibare()
+        setContentView(vue)
+        webView = vue
+        vue.loadUrl(url)
+    }
+
+    private fun refuser() {
+        Toast.makeText(this, R.string.kibare_sso_erreur_certificat, Toast.LENGTH_LONG).show()
+        finish()
+    }
+
+    override fun onDestroy() {
+        // Libérer la vue web évite de garder en mémoire la page de connexion,
+        // donc d'éventuels identifiants saisis.
+        webView?.let {
+            it.stopLoading()
+            it.destroy()
+        }
+        webView = null
+        super.onDestroy()
+    }
+
+    private inner class ClientKibare : WebViewClient() {
+
+        /**
+         * Fin du parcours SSO : le serveur renvoie vers « element://connect… ».
+         * Ce lien n'est pas une page web, il est traité par l'application
+         * elle-même (SSORedirectRouterActivity, déclarée dans le manifeste).
+         */
+        override fun shouldOverrideUrlLoading(view: WebView, request: WebResourceRequest): Boolean {
+            val uri = request.url
+            if (uri.scheme == SCHEMA_RETOUR) {
+                try {
+                    startActivity(Intent(Intent.ACTION_VIEW, uri))
+                } catch (erreur: ActivityNotFoundException) {
+                    Toast.makeText(
+                            this@KibareSsoWebActivity,
+                            R.string.kibare_sso_erreur_retour,
+                            Toast.LENGTH_LONG
+                    ).show()
+                }
+                finish()
+                return true
+            }
+            return false
+        }
+
+        /**
+         * La vue web signale que le certificat lui est inconnu — ce qui est
+         * attendu, puisqu'elle ignore l'autorité de l'État.
+         *
+         * On n'accepte QUE si l'adresse en cause est exactement celle dont
+         * l'authenticité a déjà été prouvée au démarrage, par notre propre
+         * connexion sécurisée. Toute autre adresse est refusée : une page
+         * détournée en cours de parcours ne peut pas profiter de l'exception.
+         */
+        override fun onReceivedSslError(view: WebView, handler: SslErrorHandler, error: SslError) {
+            val hote = Uri.parse(error.url ?: "").host
+            if (hote != null && hote == hoteAuthentifie) {
+                handler.proceed()
+            } else {
+                handler.cancel()
+                refuser()
+            }
+        }
+    }
+
+    /**
+     * Ouvre une connexion sécurisée vers le serveur en n'acceptant QUE
+     * l'autorité de l'État embarquée dans l'application.
+     *
+     * Retourne vrai uniquement si la négociation aboutit, ce qui prouve que :
+     *   1. le certificat du serveur est signé par l'autorité de l'État ;
+     *   2. il n'est ni expiré ni invalide ;
+     *   3. il a bien été délivré pour l'adresse visitée.
+     *
+     * La troisième condition est celle qui empêche un serveur légitime de se
+     * faire passer pour un autre.
+     */
+    private fun serveurPresenteUnCertificatDeLEtat(url: String): Boolean {
+        val contexte = contexteSslDeLEtat() ?: return false
+
+        var connexion: HttpsURLConnection? = null
+        return try {
+            connexion = (URL(url).openConnection() as HttpsURLConnection).apply {
+                sslSocketFactory = contexte.socketFactory
+                connectTimeout = DELAI_MS
+                readTimeout = DELAI_MS
+                // La négociation sécurisée suffit : le contenu de la réponse
+                // ne nous intéresse pas ici.
+                requestMethod = "HEAD"
+            }
+            connexion.connect()
+            // serverCertificates n'est disponible qu'après une négociation
+            // réussie : y accéder confirme la validation.
+            connexion.serverCertificates.isNotEmpty()
+        } catch (erreur: IOException) {
+            // Englobe l'échec de validation du certificat (SSLHandshakeException)
+            // comme le serveur injoignable.
+            false
+        } catch (erreur: IllegalStateException) {
+            false
+        } finally {
+            connexion?.disconnect()
+        }
+    }
+
+    /**
+     * Construit un contexte sécurisé dont la SEULE autorité de confiance est
+     * celle de l'État. Les autorités préinstallées par le fabricant du
+     * téléphone ne sont volontairement pas incluses.
+     */
+    private fun contexteSslDeLEtat(): SSLContext? {
+        return try {
+            val autorite = resources.openRawResource(R.raw.kibare_ca).use { flux ->
+                CertificateFactory.getInstance("X.509").generateCertificate(flux) as X509Certificate
+            }
+
+            val magasin = KeyStore.getInstance(KeyStore.getDefaultType()).apply {
+                load(null, null)
+                setCertificateEntry("kibare-ca", autorite)
+            }
+
+            val fabrique = TrustManagerFactory
+                    .getInstance(TrustManagerFactory.getDefaultAlgorithm())
+                    .apply { init(magasin) }
+
+            SSLContext.getInstance("TLS").apply {
+                init(null, fabrique.trustManagers, null)
+            }
+        } catch (erreur: java.security.GeneralSecurityException) {
+            null
+        } catch (erreur: IOException) {
+            null
+        }
+    }
+
+    companion object {
+        private const val EXTRA_SSO_URL = "EXTRA_SSO_URL"
+        private const val SCHEMA_RETOUR = "element"
+        private const val DELAI_MS = 15_000
+
+        fun intent(contexte: Context, ssoUrl: String): Intent {
+            return Intent(contexte, KibareSsoWebActivity::class.java)
+                    .putExtra(EXTRA_SSO_URL, ssoUrl)
+        }
+    }
+}
