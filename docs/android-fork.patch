+        android:fillColor="#FFFFFF"
+        android:fillType="nonZero"/>
+    <path
+        android:pathData="M 80 50 a 8.5 8.5 0 0 1 17 0 v 6 h -5.5 v -6 a 3 3 0 0 0 -6 0 v 6 H 80 Z"
+        android:fillColor="#FFFFFF"
+        android:fillType="nonZero"/>
+    <path
+        android:pathData="M 81.5 55 H 95.5 a 4 4 0 0 1 4 4 V 70 a 4 4 0 0 1 -4 4 H 81.5 a 4 4 0 0 1 -4 -4 V 59 a 4 4 0 0 1 4 -4 Z"
+        android:fillColor="#FFFFFF"
+        android:fillType="nonZero"/>
+    <path
+        android:pathData="M 85.6 62.5 a 2.9 2.9 0 1 0 5.8 0 a 2.9 2.9 0 1 0 -5.8 0 Z"
+        android:fillColor="#DB1E1D"
