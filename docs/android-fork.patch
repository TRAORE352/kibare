diff --git a/vector-app/proguard-rules.pro b/vector-app/proguard-rules.pro
index 0fed148..59b6a73 100644
--- a/vector-app/proguard-rules.pro
+++ b/vector-app/proguard-rules.pro
@@ -22,6 +22,25 @@
 
 -keep class im.vector.app.features.** { *; }
 
+# KIBARÉ : conserver nos vues personnalisées et tout le paquet « core ».
+#
+# Pourquoi : nous activons removeUnusedCode (R8) pour alléger l'APK. R8 ne
+# voit pas les classes instanciées depuis un fichier XML de mise en page :
+# il les croit inutilisées et les supprime. L'application planterait alors
+# à l'ouverture d'une conversation avec « ClassNotFoundException:
+# im.vector.app.core.ui.views.WatermarkView ».
+#
+# Notre filigrane (protection « Zéro fuite ») est précisément dans ce cas :
+# il est déclaré dans fragment_timeline.xml et activity_big_image_viewer.xml.
+-keep class im.vector.app.core.** { *; }
+
+# Règle générale de sécurité : toute vue Android référencée depuis un XML
+# doit garder son constructeur (Context, AttributeSet).
+-keepclasseswithmembers class * extends android.view.View {
+    public <init>(android.content.Context, android.util.AttributeSet);
+    public <init>(android.content.Context, android.util.AttributeSet, int);
+}
+
 ## print all the rules in a file
 # -printconfiguration ../proguard_files/full-r8-config.txt
 
diff --git a/vector-app/src/main/res/drawable-anydpi-v26/ic_launcher_foreground.xml b/vector-app/src/main/res/drawable-anydpi-v26/ic_launcher_foreground.xml
index a02583e..cfe92e5 100644
--- a/vector-app/src/main/res/drawable-anydpi-v26/ic_launcher_foreground.xml
+++ b/vector-app/src/main/res/drawable-anydpi-v26/ic_launcher_foreground.xml
@@ -1,22 +1,59 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  KIBARÉ — avant-plan de l'icône de lancement.
+
+  GÉNÉRÉ par design/generer-icone-android.py depuis design/icone-kibare.svg.
+  Ne pas modifier à la main : relancer le script.
+
+  Le groupe applique une échelle de 0.64 et un recentrage, afin que le
+  dessin tienne dans le cercle « sûr » des icônes adaptatives (rayon 33 autour
+  du centre 54,54 dans un repère 108x108). Le lanceur du téléphone découpe
+  l'icône selon sa propre forme ; rien n'est donc jamais rogné.
+
+  Le fond est blanc (drawable/ic_launcher_background.xml) : la charte
+  interdit de poser le symbole sur un aplat coloré saturé.
+-->
