diff --git a/vector-app/src/main/res/drawable/ic_launcher_monochrome.xml b/vector-app/src/main/res/drawable/ic_launcher_monochrome.xml
new file mode 100644
index 0000000..38d8bdb
--- /dev/null
+++ b/vector-app/src/main/res/drawable/ic_launcher_monochrome.xml
@@ -0,0 +1,32 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  KIBARÉ — silhouette monochrome de l'icône (thème dynamique Android 13+).
+
+  GÉNÉRÉ par design/generer-icone-android.py depuis design/icone-kibare.svg.
+  Ne pas modifier à la main : relancer le script.
+
+  Le groupe applique une échelle de 0.64 et un recentrage, afin que le
+  dessin tienne dans le cercle « sûr » des icônes adaptatives (rayon 33 autour
+  du centre 54,54 dans un repère 108x108). Le lanceur du téléphone découpe
+  l'icône selon sa propre forme ; rien n'est donc jamais rogné.
+
+  Le système remplit cette silhouette d'une seule couleur. Les points et le
+  cadenas sont donc PERCÉS dans la bulle (règle evenOdd) : posés dessus,
+  ils disparaîtraient et l'icône deviendrait une tache uniforme.
+-->
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="108dp"
+    android:height="108dp"
+    android:viewportWidth="108"
+    android:viewportHeight="108">
+  <group
+      android:scaleX="0.64"
+      android:scaleY="0.64"
+      android:translateX="15.6000"
+      android:translateY="13.0400">
+    <path
+        android:pathData="M 32 26 H 88 a 15 15 0 0 1 15 15 V 73 a 15 15 0 0 1 -15 15 H 55 l -13 14 V 88 H 32 a 15 15 0 0 1 -15 -15 V 41 a 15 15 0 0 1 15 -15 Z M 27.4 56 a 6.6 6.6 0 1 0 13.2 0 a 6.6 6.6 0 1 0 -13.2 0 Z M 44.4 56 a 6.6 6.6 0 1 0 13.2 0 a 6.6 6.6 0 1 0 -13.2 0 Z M 61.4 56 a 6.6 6.6 0 1 0 13.2 0 a 6.6 6.6 0 1 0 -13.2 0 Z M 80 50 a 8.5 8.5 0 0 1 17 0 v 5 h -5.5 v -5 a 3 3 0 0 0 -6 0 v 5 H 80 Z M 81.5 55 H 95.5 a 4 4 0 0 1 4 4 V 70 a 4 4 0 0 1 -4 4 H 81.5 a 4 4 0 0 1 -4 -4 V 59 a 4 4 0 0 1 4 -4 Z"
+        android:fillColor="#FFFFFF"
+        android:fillType="evenOdd"/>
+  </group>
+</vector>
diff --git a/vector-app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml b/vector-app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml
