+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  KIBARÉ : symbole de l'application, pour les écrans (accueil, en-têtes).
+
+  Même tracé que l'icône de lancement (design/icone-kibare.svg), ramené du
+  repère 120 au repère 48 par un groupe d'échelle : les deux ne peuvent donc
+  pas diverger. Deux unités de marge de chaque côté empêchent le symbole de
+  toucher les bords du cadre quand il est posé contre un autre élément.
+-->
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="48dp"
+    android:height="48dp"
+    android:viewportWidth="48"
+    android:viewportHeight="48">
