diff --git a/matrix-sdk-android/src/main/res/xml/network_security_config.xml b/matrix-sdk-android/src/main/res/xml/network_security_config.xml
index e40c61c..09300ac 100644
--- a/matrix-sdk-android/src/main/res/xml/network_security_config.xml
+++ b/matrix-sdk-android/src/main/res/xml/network_security_config.xml
@@ -1,16 +1,21 @@
 <?xml version="1.0" encoding="utf-8"?>
 <network-security-config>
-    <!-- Ref: https://developer.android.com/training/articles/security-config.html -->
-    <!-- By default, do not allow clearText traffic -->
-    <base-config cleartextTrafficPermitted="false" />
+    <!--
+        Kibaré : l'application ne parle QU'AU serveur Kibaré (aucun autre service).
+        On ne fait donc confiance QU'À la CA locale « Kibaré CA » (section 5.7 du
+        brief) : le certificat serveur, signé par cette CA, est accepté, et aucun
+        autre certificat (autorité publique) ne l'est.
+    -->
+    <base-config cleartextTrafficPermitted="false">
+        <trust-anchors>
+            <certificates src="@raw/kibare_ca" />
+        </trust-anchors>
+    </base-config>
 
-    <!-- Allow clearText traffic on some specified host -->
+    <!-- Trafic en clair autorisé uniquement pour le développement local. -->
     <domain-config cleartextTrafficPermitted="true">
-        <!-- Localhost -->
         <domain includeSubdomains="true">localhost</domain>
         <domain includeSubdomains="true">127.0.0.1</domain>
-        <!-- Localhost for Android emulator -->
         <domain includeSubdomains="true">10.0.2.2</domain>
     </domain-config>
-
 </network-security-config>
