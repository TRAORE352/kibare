diff --git a/matrix-sdk-android/src/main/java/org/matrix/android/sdk/internal/session/room/read/SetReadMarkersTask.kt b/matrix-sdk-android/src/main/java/org/matrix/android/sdk/internal/session/room/read/SetReadMarkersTask.kt
index 5c44931..a26f183 100644
--- a/matrix-sdk-android/src/main/java/org/matrix/android/sdk/internal/session/room/read/SetReadMarkersTask.kt
+++ b/matrix-sdk-android/src/main/java/org/matrix/android/sdk/internal/session/room/read/SetReadMarkersTask.kt
@@ -57,6 +57,12 @@ internal interface SetReadMarkersTask : Task<SetReadMarkersTask.Params, Unit> {
 private const val READ_MARKER = "m.fully_read"
 private const val READ_RECEIPT = "m.read"
 
+// Kibaré : accusé de lecture PRIVÉ (MSC2285, stable depuis Matrix 1.4). Le serveur
+// enregistre la position de lecture pour l'utilisateur lui-même, mais ne la diffuse
+// pas aux autres membres du salon. Cela retire au serveur et aux collègues
+// l'information « qui a lu quoi et à quelle heure » (section 5.5 du brief).
+private const val READ_RECEIPT_PRIVATE = "m.read.private"
+
 internal class DefaultSetReadMarkersTask @Inject constructor(
         private val roomAPI: RoomAPI,
         @SessionDatabase private val monarchy: Monarchy,
@@ -114,14 +120,20 @@ internal class DefaultSetReadMarkersTask @Inject constructor(
                     globalErrorReceiver,
                     canRetry = true
             ) {
-                if (markers[READ_MARKER] == null) {
-                    if (readReceiptEventId != null) {
-                        val readBody = ReadBody(threadId = params.readReceiptThreadId)
-                        roomAPI.sendReceipt(params.roomId, READ_RECEIPT, readReceiptEventId, readBody)
-                    }
-                } else {
-                    // "m.fully_read" value is mandatory to make this call
-                    roomAPI.sendReadMarker(params.roomId, markers)
+                // Kibaré : l'accusé de lecture part TOUJOURS en « m.read.private », jamais
+                // dans le corps de sendReadMarker (qui utilise « m.read », donc public).
+                // On envoie donc les deux informations séparément :
+                //  - la position de lecture, en privé, via sendReceipt ;
+                //  - le marqueur « lu jusqu'ici » (m.fully_read), qui est déjà privé par
+                //    nature (c'est une donnée de compte, non diffusée aux autres membres).
+                val privateReceiptEventId = markers[READ_RECEIPT]
+                if (privateReceiptEventId != null) {
+                    val readBody = ReadBody(threadId = params.readReceiptThreadId)
+                    roomAPI.sendReceipt(params.roomId, READ_RECEIPT_PRIVATE, privateReceiptEventId, readBody)
+                }
+                val fullyRead = markers[READ_MARKER]
+                if (fullyRead != null) {
+                    roomAPI.sendReadMarker(params.roomId, mapOf(READ_MARKER to fullyRead))
                 }
             }
         }
