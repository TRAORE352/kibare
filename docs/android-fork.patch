+        android:fillColor="#DB1E1D"
+        android:fillType="nonZero"/>
+    <path
+        android:pathData="M 27.4 56 a 6.6 6.6 0 1 0 13.2 0 a 6.6 6.6 0 1 0 -13.2 0 Z"
+        android:fillColor="#FFFFFF"
+        android:fillType="nonZero"/>
