# =====================================================================
# Caddyfile — reverse proxy HTTPS avec CA locale (aucun Let's Encrypt)
# Point d'entrée unique sur le port 443.
# =====================================================================

{
    # Désactive ACME / Let's Encrypt et l'API admin locale
    admin off
    auto_https off

    # Désactive HTTP/3 (QUIC) : il nécessiterait le port 443 UDP non publié.
    servers {
        protocols h1 h2
    }
}

# Point d'entrée unique : « :443 » = toutes les connexions HTTPS sur 443.
# IMPORTANT : on n'utilise PAS l'adresse IP dans l'adresse du site, car derrière
# Docker la connexion arrive sur l'IP interne du conteneur et SANS SNI
# (connexion par IP) : l'IP du site ne correspondrait jamais.
:443 {
    # Certificat serveur signé par la CA locale (généré par scripts/init.sh)
    tls /etc/caddy/kibare-server.crt /etc/caddy/kibare-server.key

    # En-têtes de sécurité
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        -Server
    }

    # Health check de la porte d'entrée
    handle /health {
        respond "OK" 200
    }

    # Téléchargement du certificat CA (à installer sur le téléphone)
    handle /kibare-ca.crt {
        root * /srv
        file_server
    }

    # Synapse — API client Matrix (on conserve le préfixe /_matrix)
    handle /_matrix/* {
        reverse_proxy synapse:8008
    }

    # Synapse — API d'administration
    handle /_synapse/* {
        reverse_proxy synapse:8008
    }

    # Keycloak — authentification (préfixe /auth)
    handle /auth/* {
        reverse_proxy keycloak:8080
    }

    # Console Kibaré — administration
    handle /console/* {
        reverse_proxy console:8000
    }

    # Activation publique par lien à usage unique
    handle /activer/* {
        reverse_proxy console:8000
    }

    # Racine : redirection vers la console
    handle {
        redir * /console/ 302
    }

    # Logs structurés JSON (jamais le contenu des messages)
    log {
        output stdout
        format json
    }
}
