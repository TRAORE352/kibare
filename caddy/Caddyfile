# =====================================================================
# Caddyfile — reverse proxy HTTPS avec CA locale (aucun Let's Encrypt)
# Point d'entrée unique. L'adresse du serveur est injectée via la
# variable d'environnement KIBARE_SERVER_ADDRESS.
# =====================================================================

{
    # Désactive ACME / Let's Encrypt et l'API admin locale
    admin off
    auto_https off

    # Désactive HTTP/3 (QUIC) : il nécessiterait le port 443 UDP, qui n'est
    # pas publié par Docker. On garde HTTP/1.1 + HTTP/2 (TCP), plus robuste.
    servers {
        protocols h1 h2
    }
}

# Serveur principal : adresse IP (canonique) + alias DNS locaux
https://{$KIBARE_SERVER_ADDRESS}, https://kibare.test, https://kibare.lan {
    # Certificat serveur signé par la CA locale (généré par scripts/init.sh)
    tls /etc/caddy/kibare-server.crt /etc/caddy/kibare-server.key

    # En-têtes de sécurité
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        -Server
    }

    # Health check de la porte d'entrée
    @health path /health
    respond @health "OK" 200

    # Téléchargement du certificat CA (à installer sur le téléphone pour
    # l'écran de connexion Keycloak, section 5.7 du brief).
    handle /kibare-ca.crt {
        root * /srv
        file_server
    }

    # Synapse — API client Matrix. IMPORTANT : « handle » (pas « handle_path »)
    # conserve le préfixe /_matrix lors du transfert vers Synapse.
    handle /_matrix/* {
        reverse_proxy synapse:8008
    }

    # Synapse — API d'administration
    handle /_synapse/* {
        reverse_proxy synapse:8008
    }

    # Keycloak — authentification (préfixe /auth)
    handle /auth/* {
        reverse_proxy keycloak:8080
    }

    # Console Kibaré — administration (sous /console)
    handle /console/* {
        reverse_proxy console:8000
    }

    # Activation publique par lien à usage unique (sous /activer)
    handle /activer/* {
        reverse_proxy console:8000
    }

    # Racine : redirection vers la console
    handle {
        redir /console/ 302
    }

    # Logs structurés JSON (jamais le contenu des messages)
    log {
        output stdout
        format json
    }
}
